{
  "detection": {
    "enabled": true,
    "logFile": "./attacks.json",
    "patterns": {
      "sqlInjection": true,
      "rce": true,
      "pathTraversal": true,
      "commandInjection": true,
      "xss": true,
      "noSqlInjection": true,
      "xxe": true,
      "ldapInjection": true
    }
  },
  "rateLimit": {
    "enabled": true,
    "threshold": 5,
    "window": 10000,
    "blockIP": false
  },
  "dashboard": {
    "enabled": true,
    "port": 3000,
    "refreshInterval": 2000
  },
  "logging": {
    "level": "info",
    "console": true,
    "file": "./shield.log"
  },
  "alerts": {
    "email": false,
    "slack": false,
    "webhook": null
  }
}
