# =============================================================================
# Node Shield - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment

# SERVER
PORT=3001
NODE_ENV=production

# DATABASE
# Leave DB_HOST empty to use in-memory storage (development only)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=node_shield
DB_USER=shield_user
# CHANGE THIS! Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# SECURITY
# Generate API Key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=CHANGE_ME_TO_A_GENERATED_API_KEY
ENABLE_AUTH=true

# DASHBOARD
DASHBOARD_REFRESH_INTERVAL=2000
MAX_DASHBOARD_RECORDS=1000

# RATE LIMITING
RATE_LIMIT_ENABLED=true
RATE_LIMIT_THRESHOLD=5
RATE_LIMIT_WINDOW=10000
AUTO_BLOCK_IP=false
MAX_BLOCKED_IPS=1000

# LOGGING
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=./logs/shield.log
MAX_LOG_SIZE=10485760
MAX_LOG_FILES=10

# DATA RETENTION
ATTACK_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# MONITORING
ENABLE_METRICS=true
METRICS_PORT=9090

# CORS
CORS_ORIGIN=localhost,127.0.0.1
CORS_ENABLED=false

# FEATURES
ENABLE_WHITELIST=true
ENABLE_BLACKLIST=true
ENABLE_CLEANUP=true
VERBOSE_LOGGING=false
