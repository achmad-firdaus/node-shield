# Node Shield Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL) - Optional
# If not set, will use in-memory storage
DB_HOST=localhost
DB_PORT=5432
DB_NAME=node_shield
DB_USER=shield_user
DB_PASSWORD=shield_password

# Security (for future use)
# DASHBOARD_AUTH_ENABLED=true
# DASHBOARD_AUTH_TOKEN=your-secret-token
